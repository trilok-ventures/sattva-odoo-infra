# =============================================================================
# PRODUCTION environment file (EXAMPLE) — Compose-on-VM in sattva-prod-ca
# =============================================================================
# Copy to `.env` in this directory and chmod 600, OR generate it with
# `deploy/gcp/fetch-secrets.sh` from AssetCo Secret Manager.
# NEVER commit real secrets. Names match deploy/gcp/secret-names.md.
# =============================================================================

# --- Postgres / Odoo DB user password  (secret: odoo-db-password) ------------
POSTGRES_PASSWORD=CHANGE_ME

# --- Odoo master / database-manager password  (secret: odoo-admin-passwd) ----
ODOO_ADMIN_PASSWD=CHANGE_ME

# --- n8n encryption key  (secret: n8n-encryption-key) ------------------------
N8N_ENCRYPTION_KEY=CHANGE_ME

# --- n8n webhook HMAC  (secret: n8n-webhook-hmac) ----------------------------
N8N_WEBHOOK_HMAC=CHANGE_ME

# --- Nextcloud admin  (secret: nextcloud-admin-password) ---------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

# --- n8n Postgres user  (secret: n8n-db-password) ----------------------------
N8N_DB_PASSWORD=CHANGE_ME

# --- Nextcloud WebDAV account used by n8n (not the admin) --------------------
NEXTCLOUD_N8N_USER=n8n.vault

# --- n8n Odoo uid for execute_kw (create user n8n.fabric first; do not use admin=2)
ODOO_N8N_UID=

# --- Optional ACME contact (unused with Origin Certificate) ------------------
ACME_EMAIL=admin@trilokventures.org
