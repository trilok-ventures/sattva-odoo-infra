# =============================================================================
# Sattva / Trilok Ventures - PRODUCTION environment file (EXAMPLE)
# =============================================================================
# Copy this to `.env` IN THIS SAME DIRECTORY (deploy/prod/.env) and fill in real
# secrets. `.env` is git-ignored - NEVER commit real secrets.
#
#     cp .env.example .env && chmod 600 .env
#
# docker compose automatically loads `deploy/prod/.env` when you run the
# `docker compose -f docker-compose.prod.yml ...` commands from this directory.
# These values are injected into the containers via `env_file:` and are used to
# render the Postgres password + Odoo master password at runtime.
# =============================================================================

# --- Postgres / Odoo DB user password ----------------------------------------
# Used by BOTH the `db` container (POSTGRES_PASSWORD) and rendered into
# odoo.conf as db_password. Generate a strong value, e.g.:  openssl rand -base64 30
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Odoo master / database-manager password ---------------------------------
# Rendered into odoo.conf as admin_passwd. Protects the DB manager screens.
# Generate a strong value, e.g.:  openssl rand -base64 30
ODOO_ADMIN_PASSWD=CHANGE_ME_strong_master_password

# --- (Optional) ACME contact email -------------------------------------------
# Only used if you switch Caddy to automatic Let's Encrypt issuance (DNS-01).
# Not needed for the default Cloudflare Origin Certificate mode.
ACME_EMAIL=admin@trilokventures.org

# --- (Optional) Cloudflare API token -----------------------------------------
# Only needed if you use Caddy automatic TLS via the Let's Encrypt DNS-01
# challenge (requires a Caddy build that includes the caddy-dns/cloudflare
# plugin). Scope: Zone.DNS:Edit on the trilokventures.org zone.
# Leave blank when using a Cloudflare Origin Certificate (recommended).
CLOUDFLARE_API_TOKEN=
