<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_sattva_compliance" model="ir.ui.view">
        <field name="name">res.partner.form.sattva.compliance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sattva Compliance" name="sattva_compliance">
                    <group>
                        <group string="Supplier PCP">
                            <field name="supplier_pcp_status"/>
                            <field name="risk_band"/>
                            <field name="haccp_certified"/>
                            <field name="brc_certified"/>
                            <field name="nextcloud_folder_path"/>
                        </group>
                        <group string="Buyer KYC">
                            <field name="buyer_kyc_status"/>
                            <field name="nextcloud_client_folder_path"/>
                        </group>
                        <group string="Buyer SFC">
                            <field name="buyer_sfc_status"/>
                            <field name="buyer_sfc_licence"/>
                        </group>
                        <group string="Exporter IDs">
                            <field name="spices_board_rcm"/>
                            <field name="fssai_licence"/>
                            <field name="us_fda_fei"/>
                            <field name="steam_sterilization_cap"/>
                            <field name="last_audit_date"/>
                        </group>
                        <group string="Logistics / 3PL">
                            <field name="is_logistics_partner"/>
                            <field name="forwarder_status"/>
                            <field name="cbsa_bond_ref"/>
                            <field name="insurance_coverage_ref"/>
                            <field name="cfia_swi_capable"/>
                            <field name="incoterm_fob"/>
                            <field name="incoterm_cif"/>
                            <field name="incoterm_dap"/>
                        </group>
                        <group string="Credit (v1)">
                            <field name="industry_sector"/>
                            <field name="payment_score_punctuality"/>
                            <field name="payment_score_volume"/>
                            <field name="payment_score_market"/>
                            <field name="payment_score_financial" groups="account.group_account_manager"/>
                            <field name="payment_score_paydex" groups="account.group_account_manager"/>
                            <field name="payment_score_total"/>
                            <field name="credit_risk_tier"/>
                        </group>
                    </group>
                    <button name="action_recompute_payment_score" type="object"
                            string="Snapshot credit score"
                            class="btn-secondary"
                            groups="account.group_account_manager"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
