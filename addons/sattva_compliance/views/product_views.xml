<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_sattva_spec" model="ir.ui.view">
        <field name="name">product.template.form.sattva.spec</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sattva GREEN spec" name="sattva_green_spec">
                    <group>
                        <group string="Lab thresholds">
                            <field name="sattva_moisture_max"/>
                            <field name="sattva_mesh_required"/>
                            <field name="sattva_salmonella_required"/>
                            <field name="sattva_tpc_max"/>
                            <field name="sattva_pyruvic_min"/>
                        </group>
                        <group string="Catalogue labels">
                            <field name="sattva_crop"/>
                            <field name="sattva_format"/>
                            <field name="sattva_mesh_label"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
