<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_sattva" model="ir.ui.view">
        <field name="name">product.template.form.sattva</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sattva Catalog" name="sattva_catalog">
                    <group>
                        <group string="Crop">
                            <field name="sattva_crop"/>
                            <field name="sattva_format"/>
                            <field name="sattva_mesh_label"/>
                            <field name="product_family_code"/>
                            <field name="spec_pyruvic_required"/>
                        </group>
                        <group string="GREEN spec (compliance writes)">
                            <field name="spec_moisture_max"/>
                            <field name="spec_mesh_required"/>
                            <field name="spec_salmonella_required"/>
                            <field name="spec_tpc_max"/>
                            <field name="spec_pyruvic_min"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
